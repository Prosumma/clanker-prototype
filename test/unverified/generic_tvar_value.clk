module Unverified.GenericTVarValue

-- As a value, a generic function instantiated with a TVar's refined
-- contents would take unchecked inputs (review #43).
-- expect: `put` is only called directly here
-- line: 20
import Std.Stm (Stm, Atomic, TVar, new_tvar, read, write, atomically)

type Cents = Int where self >= 0

function put[A](t: TVar[A], v: A) -> Unit
  effects { Stm }
is
  write(t, v)
end

function sneaky(balance: TVar[Cents]) -> Unit
  effects { Stm }
is
  let p = put
  p(balance, -1)
end
