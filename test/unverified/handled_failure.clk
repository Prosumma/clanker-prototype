module Unverified.HandledFailure

import Std.Fail (Fail, fail)

type Oops = variant
  Oops
end

-- `fail` doesn't return, but the handler does: what follows is live, and
-- its division by zero must be found. (It doesn't use the handler's value,
-- which the verifier doesn't know.)
-- expect: the divisor isn't zero
-- line: 19
function f() -> Int is
  let _ = handle fail(Oops)
    on fail(_) => 0
  end
  let zero = 0
  100 / zero
end
