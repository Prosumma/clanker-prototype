module Reject.CellEscapeResult

-- expect: the cell made by this `with_state` would outlive it, in what it returns
-- line: 10

import Std.State (Ref, Local, with_state, get, put)

-- Returning the cell would let it be used after its `with_state`.
function f() -> Int is
  let c = with_state(initial: 0, body: function(c) => c)
  0
end
