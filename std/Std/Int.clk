module Std.Int

-- Fixed-width integers. Their `+`, `-`, `*` carry an overflow proof
-- obligation, so they aren't `Num`; `Wrapping` gives arithmetic modulo 2^n
-- (DESIGN §1, §2.2).

import Std.Core (Hash, Add, Sub, Mul, Div, IntLiteral)

--| Implemented by each fixed-width integer type.
public class FixedWidth[I]
end

--| Arithmetic modulo 2^n: defined for all inputs, so it is `Num`.
public type Wrapping[I: FixedWidth] = newtype public I deriving (Eq)

public primitive function bit_xor[I: FixedWidth](
  _ left: Wrapping[I],
  _ right: Wrapping[I],
) -> Wrapping[I]

public primitive function widen(value: UInt8) -> UInt64

primitive instance[I: FixedWidth] Add[Wrapping[I]]

primitive instance[I: FixedWidth] Sub[Wrapping[I]]

primitive instance[I: FixedWidth] Mul[Wrapping[I]]

primitive instance[I: FixedWidth] IntLiteral[Wrapping[I]]

primitive instance[I: FixedWidth] Num[Wrapping[I]]

primitive instance[I: FixedWidth] Display[Wrapping[I]]

